{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "task21": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },

  "AllowedHosts": "*",

  "PaginationOptions": {
    "DefaultPageSize": 15,
    "MaxPageSize": 50
  },

  "EmailOptions": {
    "SmtpHost": "smtp.gmail.com",
    "Port": 587,
    "FromAddress": "admin@test.com"
  }
}